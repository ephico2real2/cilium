#! --cluster-id=5 --cluster-name=cluster5 --clustermesh-service-v2=only-endpointslice

hive/start

# Assert that the ClusterConfig has been correctly created
kvstore/list -o json cilium/cluster-config config.actual
* cmp config.actual config.expected

# ---

-- config.expected --
# cilium/cluster-config/cluster5
{
  "id": 5,
  "capabilities": {
    "syncedCanaries": true,
    "workloadIdentityV1": true,
    "ztunnelMembershipV1": true,
    "maxConnectedClusters": 255,
    "serviceExportsEnabled": false,
    "endpointSlicesExportMode": "endpointslices-only"
  }
}
